<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}Erreur {{ status_code }}{% endblock %} - Extranet</title>
    <style>
        :root { --bg: #f6f7f9; --card: #fff; --text: #1f2937; --muted: #6b7280; --accent: #0d6efd; }
        @media (prefers-color-scheme: dark) {
            :root { --bg: #111827; --card: #1f2937; --text: #f3f4f6; --muted: #9ca3af; --accent: #60a5fa; }
        }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
               padding: 16px; background: var(--bg); color: var(--text);
               font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        main { max-width: 560px; width: 100%; background: var(--card); border-radius: 12px;
               padding: 40px 32px; box-shadow: 0 4px 24px rgba(0,0,0,.08); text-align: center; }
        .code { font-size: 64px; font-weight: 700; color: var(--accent); margin: 0; line-height: 1; }
        h1 { font-size: 24px; margin: 16px 0 8px; }
        p { color: var(--muted); line-height: 1.5; margin: 0 0 24px; }
        a.btn { display: inline-block; padding: 10px 20px; border-radius: 8px; background: var(--accent);
                color: #fff; text-decoration: none; font-weight: 500; }
    </style>
</head>
<body>
<main>
    <p class="code">{{ status_code }}</p>
    <h1>{% block heading %}{{ status_text }}{% endblock %}</h1>
    <p>{% block message %}Une erreur est survenue. Veuillez réessayer plus tard.{% endblock %}</p>
    <a class="btn" href="/">Retour à l'accueil</a>
</main>
</body>
</html>
